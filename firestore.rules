rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Is the person making this request signed in (anonymous counts)?
    function signedIn() {
      return request.auth != null;
    }

    // Does the requester's account have an email on it? Starting or joining a circle needs one, so a
    // person can always get back in, and someone removed from a circle cannot return as a brand-new nobody.
    function hasEmail() {
      return signedIn() && request.auth.token.email != null;
    }

    // Is the requester a member of circle `cid`? Membership = having a doc at
    // circles/{cid}/members/{their uid}. This is the one gate for all circle data.
    function isMember(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/circles/$(cid)/members/$(request.auth.uid));
    }

    // Did the requester just accept the swap for ride-and-day `key`, as themselves?
    // `getAfter` looks at the data as it will be once this same save finishes.
    function acceptedSwapBy(cid, key) {
      let swap = getAfter(/databases/$(database)/documents/circles/$(cid)/swaps/$(key)).data;
      return swap.status == 'accepted'
        && swap.acceptedByUid == request.auth.uid
        && request.resource.data.driverUid == request.auth.uid;
    }

    // Is the requester the person who STARTED circle `cid`? Only they let new people in.
    function isStarter(cid) {
      return signedIn()
        && get(/databases/$(database)/documents/circles/$(cid)).data.adminUid == request.auth.uid;
    }

    // Is the requester an ORGANIZER of circle `cid`? That is the person who started it, or
    // anyone they have promoted to co-organizer. They must also be a member.
    function isOrganizer(cid) {
      let c = get(/databases/$(database)/documents/circles/$(cid)).data;
      return isMember(cid)
        && (c.adminUid == request.auth.uid
            || ('coOrganizerUids' in c && request.auth.uid in c.coOrganizerUids));
    }

    // Is the requester a PARENT of this child? That is whoever added the child, plus
    // any other parent they have listed (for example the other parent in the household).
    function isGuardian(kid) {
      return request.auth.uid == kid.ownerUid
        || ('guardianUids' in kid && request.auth.uid in kid.guardianUids);
    }

    // A person's own profile and their list of circles: visible to nobody else.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /memberships/{cid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // A household: the small private record shared by the people in one family (for now it holds
    // the home address). Only the people listed in it can read or change it. Anyone can start one,
    // but only with themselves in it, and a member can't remove themselves by accident through an
    // update. Nobody can delete one. It is never visible to the circles you belong to.
    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids
        && request.auth.uid in request.resource.data.memberUids;
      allow delete: if false;
    }

    // Invite codes. You can fetch ONE if you already know its code, but nobody
    // can list them. The long random code is the key. Only a circle's organizer
    // can create one, and they can never be changed afterward.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if hasEmail()
        && getAfter(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /circles/{cid} {
      // Only members can read the circle. Strangers get nothing.
      allow read: if isMember(cid);
      // Anyone can start a circle, but only as its organizer.
      allow create: if hasEmail() && request.resource.data.adminUid == request.auth.uid;
      // Editing the circle:
      //  - The person who started it can change its name, the driving order, archive or restore it, and who the
      //    co-organizers are. They can't hand the circle to someone else or change the
      //    invite code.
      //  - A co-organizer can change the name and the driving order, but can NOT promote
      //    or demote other organizers.
      allow update: if signedIn() && (
        (resource.data.adminUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rotation', 'coOrganizerUids', 'archived']))
        ||
        (('coOrganizerUids' in resource.data && request.auth.uid in resource.data.coOrganizerUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rotation']))
      );
      allow delete: if false;

      // The schedule. Every member can see it; only an organizer can change it.
      // `legs` = the recurring/one-off rides. `instances` = a change to one leg on
      // one day (skip it, new time). `days` = a change to a whole day (holiday).
      match /legs/{legId} {
        allow read: if isMember(cid);
        allow create, update, delete: if isOrganizer(cid);
      }
      match /instances/{key} {
        allow read: if isMember(cid);
        allow create, update, delete: if isOrganizer(cid);

        // The ONE thing a non-organizer may write here: put THEMSELVES in as the
        // driver, and only when a swap for this exact ride-and-day was accepted by
        // them in the same save. (They can't touch times or skips.)
        allow create: if isMember(cid)
          && request.resource.data.keys().hasOnly(['driverUid'])
          && acceptedSwapBy(cid, key);
        allow update: if isMember(cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverUid'])
          && acceptedSwapBy(cid, key);
      }

      // Swap requests: "I can't drive this one, who can?" The document id is the
      // ride-and-day, so there is at most one per ride per day. Any member can see
      // them; any OTHER member can accept an open one (first to save wins, because
      // once it says accepted nobody else can accept it).
      match /swaps/{key} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.status == 'open';
        allow update: if isMember(cid) && (
          // accept: open -> accepted, by someone other than the requester, as themselves
          (resource.data.status == 'open'
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedByUid == request.auth.uid
            && resource.data.requesterUid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'acceptedByUid', 'acceptedByName', 'acceptedAt']))
          ||
          // cancel: only the requester, only while open
          (resource.data.status == 'open'
            && request.resource.data.status == 'cancelled'
            && resource.data.requesterUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          ||
          // ask again after cancelling: only the requester
          (resource.data.status == 'cancelled'
            && request.resource.data.status == 'open'
            && resource.data.requesterUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt']))
        );
        allow delete: if false;
      }

      // One-tap status messages (running late, ride started, picked up...). Members
      // can read them. You can only post as yourself, and they can never be edited
      // or deleted afterward.
      match /broadcasts/{id} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.type in ['running_late', 'ride_started', 'arriving', 'picked_up',
                                            'dropped_off', 'ride_completed', 'swap_requested', 'swap_accepted']
          && request.resource.data.keys().hasAll(['type', 'fromUid', 'fromName', 'createdAt']);
        allow update, delete: if false;
      }
      // A ride happening on a particular day (started, which stop, which kids are
      // picked up). Any member can see it. Whoever starts it becomes its driver, and
      // from then on only that driver (or an organizer, to correct it) can change it. Nobody can delete one.
      match /runs/{key} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.driverUid == request.auth.uid;
        // The driver can update their own ride, and an organizer can correct any ride afterward
        // (for example fixing what was recorded for a child). Nobody can change who the driver was.
        allow update: if isMember(cid) && (resource.data.driverUid == request.auth.uid || isOrganizer(cid))
          && request.resource.data.driverUid == resource.data.driverUid;
        allow delete: if false;
      }
      match /days/{date} {
        allow read: if isMember(cid);
        allow create, update, delete: if isOrganizer(cid);
      }

      // Asking to join. An invite link only lets a person ASK: they write a request (with a valid code for
      // THIS circle), and only the person who started the circle can approve or decline it. A request can
      // be read by its owner and by the starter, and nobody else. The person can withdraw it, and the
      // starter can delete it. Once approved it is used up when the person joins (see members below).
      match /requests/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isStarter(cid));
        allow create: if hasEmail() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.circleId == cid;
        allow update: if isStarter(cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['approved', 'declined'];
        allow delete: if signedIn() && (request.auth.uid == uid || isStarter(cid));
      }

      match /members/{uid} {
        allow read: if isMember(cid);

        // You can only ever add YOURSELF, and only one of two ways:
        //  1) you are the organizer who just created this circle, or
        //  2) you hold a valid invite code for this exact circle AND the person who started it approved you.
        allow create: if hasEmail() && request.auth.uid == uid && (
          (request.resource.data.role == 'admin'
            && getAfter(/databases/$(database)/documents/circles/$(cid)).data.adminUid == uid)
          ||
          (request.resource.data.role == 'member'
            && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.circleId == cid
            && get(/databases/$(database)/documents/circles/$(cid)/requests/$(uid)).data.status == 'approved')
        );

        // You can change your own name, car, avatar color and map icon, nothing else (not your role).
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'car', 'color', 'icon']);
        // You can leave a circle. An organizer can also remove another member's card (for example when
        // that parent has a new phone and comes back as a new person), but never the circle's starter.
        allow delete: if signedIn() && (
          request.auth.uid == uid
          || (isOrganizer(cid) && uid != get(/databases/$(database)/documents/circles/$(cid)).data.adminUid)
        );
      }

      match /kids/{kidId} {
        // Every member of the circle can see its kids' profiles.
        allow read: if isMember(cid);
        // Only a parent can add a child, and it's recorded as theirs.
        allow create: if isMember(cid) && request.resource.data.ownerUid == request.auth.uid;
        // Only a parent of the child (see isGuardian) can edit or remove the profile.
        allow update: if isMember(cid) && isGuardian(resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isMember(cid) && isGuardian(resource.data);
      }
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
